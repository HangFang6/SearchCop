# ============================================================
# SearchCop · environment template
# Copy this to `.env` (gitignored) on each machine, then fill in
# the real values. NEVER commit your filled-in `.env`.
# ============================================================

# ---- Doubao (Tencent tRPC gateway) ----
# Ask the project owner for these values, or read from an internal
# secrets store. Do NOT paste them into this committed file.
DOUBAO_APP_ID=__FILL_ME__
DOUBAO_APP_KEY=__FILL_ME__
DOUBAO_SOURCE=searchcop
DOUBAO_HOST=http://trpc-gpt-eval.production.polaris:8080

# Two-tier routing
DOUBAO_MODEL_PRO=doubao-seed-2-0-pro-260215
DOUBAO_MODEL_LITE=doubao-seed-2-0-lite-260215
DOUBAO_DEFAULT_TIER=pro

# ---- LLM cache ----
LLM_CACHE_DIR=cache/llm

# ---- MySQL (reuse Gait-Project schema if needed) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=searchcop
